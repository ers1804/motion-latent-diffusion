\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces EgoPed\xspace  architecture. The ego trajectory is encoded by a \emph  {frozen} transformer encoder into 196 per-timestep conditioning tokens. At every denoising step, the noisy latent $\mathbf  {z}_t$ queries the full ego token sequence via cross-attention (\texttt  {trans\_dec} denoiser). Diffusion runs in the latent space of a frozen HumanML3D VAE; only the denoiser is trained.\relax }}{3}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{3}{\method architecture. The ego trajectory is encoded by a \emph {frozen} transformer encoder into 196 per-timestep conditioning tokens. At every denoising step, the noisy latent $\mathbf {z}_t$ queries the full ego token sequence via cross-attention (\texttt {trans\_dec} denoiser). Diffusion runs in the latent space of a frozen HumanML3D VAE; only the denoiser is trained.\relax }{figure.caption.7}{}}
