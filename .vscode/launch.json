    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Train VAE HumanML3D",
            "type": "debugpy",
            "request": "launch",
            "module": "train",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "/home/erik/anaconda3/envs/mld/bin/python",
            "args": [
                "--cfg",
                "configs/config_vae_combined_dataset.yaml",
                "--cfg_assets",
                "configs/assets.yaml",
                "--batch_size",
                "64",
                "--nodebug"
            ]
        }
    ]
}